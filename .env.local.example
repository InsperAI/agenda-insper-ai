# ─────────────────────────────────────────────────────────────────────────────
# Agenda da Diretoria · Insper AI — variáveis de ambiente
#
# Copie para `.env.local` (desenvolvimento) e cadastre as mesmas chaves no
# painel da Vercel (Production + Preview). Veja o passo a passo no README.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API → chave "anon public" (ou "Publishable key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → chave "service_role" (ou "Secret key").
# SÓ no servidor. Nunca prefixe com NEXT_PUBLIC_. Usada apenas pelo feed .ics e pelo cron.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app: http://localhost:3000 em desenvolvimento,
# https://agenda-insper-ai.vercel.app (ou o domínio próprio) em produção.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo do cron diário (/api/ping). Qualquer string aleatória longa.
CRON_SECRET=
